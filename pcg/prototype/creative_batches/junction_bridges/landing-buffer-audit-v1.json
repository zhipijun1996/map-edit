  "conclusion": "Five raw forbidden_ability counter classifications arise from the observer using the beginning-of-tick grounded/used counters for a jump executed after a real landing inside that same tick. The original game allows ordinary landing-buffered jump with maximum_jumps=1 and double_enabled=false; this is not use of an unavailable extra jump.",
  "causal_chain": [
    {
      "source": "pcg/prototype/godot/scripts/player/jump_ability.gd",
      "lines": "40-54",
      "mechanism": "request sets jump buffer; before landing used_jumps=1 >= maximum1 rejects first try_jump, preserving the buffer"
    },
    {
      "source": "pcg/prototype/godot/scripts/player/player_controller.gd",
      "lines": "130-143",
      "mechanism": "motor.step makes actual floor collision; on_landed resets jump resource then buffered try_jump executes before end-of-tick observation"
    },
    {
      "source": "pcg/prototype/godot/scripts/player/jump_ability.gd",
      "lines": "84-89",
      "mechanism": "on_landed resets used_jumps=0 and flight cap to actual maximum1"
    },
    {
      "source": "pcg/prototype/godot/runner_plains.gd",
      "lines": "28-33",
      "mechanism": "jumped callback derives kind from runner before_grounded and before_used_jumps, which were captured before the landing"
    },
    {
      "source": "pcg/prototype/godot/runner_v3.gd",
      "lines": "123-133",
      "mechanism": "before snapshot is stored during prepare_dynamic_frame, prior to original controller physics tick"
    }
