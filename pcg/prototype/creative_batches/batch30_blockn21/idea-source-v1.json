  "original_card": {
    "id": "B31-N21",
    "title": "序列庭院：离开第一层，还是补完第二铃",
    "priority": 1,
    "source_type": "actual_current_codex_authorized_subagent",
    "author": "/root/batch30_creative",
    "model_revision": "not_exposed",
    "status": "proposal_existing_Cells_new_rule_missing",
    "abilities": [
      "move",
      "jump",
      "shot_recoil"
    ],
    "physics": "NOT_RUN",
    "candidate_versions": [],
    "new_family": "UNKNOWN",
    "human_video_observation": "UNKNOWN",
    "human_playtest": "UNKNOWN",
    "production_admitted": false,
    "observe_decide": "第一枪开出中庭入口，落稳M后，玩家同时看见西高回廊B与仍上锁的东阳台C。可直接从M折向B，或跳起命中低处第二铃，同枪反冲上C。第一步不是全套开门仪式；做到一半已经改变可去之处。",
    "causal": "原ShotLatch.sequence_gate_rect在第一真实命中后永久撤去，sequence_step=1保留；第二接收器才可打开东门。M真实接地回枪。两支共享同一序列初态，B不需要补第二铃，C要实际第二次提交。不是换桥左右皮或隐藏计数器。",
    "spatial_identity": "厚西崖的腹部入口—透空中庭—西上回廊/东外挂阳台，去向在M上方展开；远景岩层有明显上下、里外关系。第二来向从东低层绕到首铃站再进同一庭院。",
    "must_preserve": [
      "同一M/同初态有两个真实动作去向",
      "第一步实际开中庭门、第二步实际开另一门",
      "B/C均有跳射/越空腔，没有安全底口补数",
      "第四口D要真实进首铃站/M并各完成两去向"
    ],
    "support": {
      "existing": [
        "原sequence_offset/sequence_gate_rect",
        "既有sequence_runner_v1安装原Cell",
        "原单跳/反冲/落地恢复"
      ],
      "missing": [
        "新庭院几何/分叉规则",
        "原Block导出薄映射两个receiver/两门与route",
        "B整图消费者sequence字段安装尚需对接，不能继承局部通过"
      ],
      "new_Cell": false
    },
    "resources_reward_recovery": "入口/M/上层台均用真实接地恢复；额外预置两铃合法但比较实际成本。先编译无奖fork；两出口地域职责独立于奖励。漏门或漏台落原底岸/一级回M，保留sequence_step；不重置进度、不造枪。",
    "return_conditions": "首三口A→B/A→C；四口另D→B/D→C。其余UNKNOWN；阶段1持久不等于任意反向已通，需Map折返时另验同世界。",
    "deDup": "G11有序事务的分叉空间适配，独立家族不主张。N06选择实桥存在状态；本案选择是否继续提交持久进度。若B变成无动作安全口、两支只有同一跳台序列，拒绝fork。",
    "cheap": [
      "A不用第一铃直接上B/越第一门",
      "M不打第二铃越东门",
      "地面一次预置两铃严格支配全部名义",
      "B出口只是恢复岸",
      "D换新初态才可完成",
      "从外邻绕高崖"
    ],
    "first8": [
      "A开第一门→M真实落地→B",
      "同几何/初态A→M→第二铃→C",
      "M省第二铃/自由枪到C",
      "A省第一铃直上B",
      "地面预置两铃再走同目标比较成本",
      "失手落底→M重试，保留step1",
      "D真实进首铃站/M→B，不改初态",
      "D同初态→C；未过不称四口"
    ],
    "stop": "先只做A/M/C核心；若第二枪及两门因果不成立，停止而不靠更多刺或词序要求。西支一旦普通走路即可到，则重构/不计fork。",
