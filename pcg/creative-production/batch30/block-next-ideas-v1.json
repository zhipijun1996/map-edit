    {
      "id": "B31-N02",
      "title": "先放走自己的台，再启动接你的台",
      "status": "proposal_existing_cells_rule_missing",
      "priority": 1,
      "observation": "P1正在横向载人，P2停在更高更远处；P1中段同时能看见P2启动铃、高B和后段离台可到的低C。",
      "decision": "留在P1后段主动离台去C，或现在跳离P1、向左下启动P2，把空中枪投资在高处运动接力。",
      "causal_relationship": "同一枪反冲人物右上，并启动不同于刚离开支撑的P2。P1继续离开；弹丸飞行与两台相对位置决定追接，而非站等两台自动会合。",
      "nonnegotiable_experience": [
        "P1/P2不同真实support_id；先乘P1，再由P2作射后第一次落脚",
        "P2命中前停泊、命中后真实启动；P1不被同枪暂停/重定相",
        "P2实际接地后才恢复下一枪；底层恢复地不算第三口"
      ],
      "cells_existing": [
        "two original ModuleMovingPlatform",
        "original ferry start/pause ShotLatch",
        "original recoil/projectile/landing renewal"
      ],
      "missing": [
        "两运动参考的几何/控制生成规则",
        "实际完整dynamic envelope与接落证据"
      ],
      "resources": "高路枪在启动P2时花掉，必须落P2恢复；不假设持续继承平台离台惯性。",
      "landform": "P1从低入口水平向东；P2在右上停泊并向更高东岸运行。铃在离台点左下、枪线不穿P1台面。上下出口都有后续职责，底岸仅回收。",
      "reward": "两个去向在决策前可见；可用等值货币，另编无奖需求。不得以币充主要道具。",
      "recovery": "失去P2后两台保留真实phase，从底岸和原楼梯重接。若只能长等整周期，退回节奏设计。",
      "direction_difference": "先验证A→B/A→C。B/C进入时phase和资源不同，反向和互通UNKNOWN。",
      "cheap_solutions": [
        "岸上预开P2后不乘P1直跳",
        "从P1直接跳高B而不接P2",
        "P1自动送到C不需主动离台",
        "站等自动会合代替启动",
        "复制旧长等待rendezvous只改标题"
      ],
      "nearest": [
        "machinery/carrier-rendezvous (pacing held)",
        "B30-C05/BlockC05",
        "human-D05/BlockD05"
      ],
      "experience_difference": "旧rendezvous等已有相位；这里一枪主动创造P2相位，原P1离去改变失误后果。C05一台选岸，D05启动同一台接自己；这里从另一移动参考部署新落点。",
      "novelty_status": "active-rendezvous repair/composition hypothesis, independent family UNKNOWN",
      "collapse_condition": "若P1同成本可省且仍是D05部署落点，归D05适配；若仍主要等相遇，沿用旧pacing hold。两台数量不算新机制。",
      "prior_feedback": "旧片37.45s、7s dwell、可能18s入场等待，已因节奏暂扣；本案应主动过程约8–10s量级，小样必须看正常速度，时间目标不是人评通过。",
      "next_step": "先A→B证明P1真实载人、空中启动P2、首次射后落P2回枪，立即对岸上预开/省P1/省P2反例；成立后才加低C。",
