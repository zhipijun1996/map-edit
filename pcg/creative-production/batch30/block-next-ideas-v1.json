  "cards": [
    {
      "id": "B31-N01",
      "title": "占口保桥，放口换岸",
      "status": "design_rejected_before_implementation",
      "priority": null,
      "observation": "宽开口A与远处已经闭合的桥B由同一铃互斥控制。人物占据A时关闭会被原防夹整笔拒绝。",
      "decision": "身体还在A时射击保留B桥并反冲上桥，或者离A后再射使B撤去、转去下层出口。",
      "causal_relationship": "人物完整身体位置决定同一弹丸命中的世界切换是否被接受，原射击反冲仍发生。",
      "nonnegotiable_experience": [
        "实际blocked事件与完整身体相交，不是隐藏脚本标记",
        "占口/离口各有多帧窗口，玩家看得懂世界为何没有切换"
      ],
      "cells_existing": [
        "paired-gate v3 atomic anti-pinch",
        "original projectile/recoil/support"
      ],
      "missing": [
        "可审计的生成规则",
        "若原画面不足，明确的blocked事务表现"
      ],
      "resources": "一枚原空中枪；落B后正常恢复，防夹不返弹药。",
      "landform": "宽A空腔之后是远B桥与上下外接岸；原下方回收岸不作为新口。",
      "reward": "两岸分别接后续路线，宝箱只提供动机，不能用奖励名称替代分叉。",
      "recovery": "同世界下层地返回A，未验证，不重置。",
      "direction_difference": "上支依赖B维持，下支使用B撤去空间；其他方向UNKNOWN。",
      "cheap_solutions": [
        "故意射空、得到几乎同样反冲并保B初态",
        "普通跳射直接到B",
        "把命中没效果当机关坏了"
      ],
      "nearest": [
        "B30-C01",
        "B30-C06",
        "B30-C10"
      ],
      "experience_difference": "想利用身体位置门控世界响应，而非仅用枪向选择高低；但该因果存在射空等价反例。",
      "design_refutation": "概念强反例：blocked命中没有任何已接受的世界副作用，故相近方向射空可能同枪同反冲保留B，不必利用防夹。没有跑真实物理，不当技术撤回；不准以必须击铃的目的词堵住。",
      "next_step": "停止实现，除非另有必要世界副作用或宽容几何证据。若需新副作用则是缺Cell，不悄悄添加。",
      "novelty_status": "rejected causal hypothesis; no family claim",
