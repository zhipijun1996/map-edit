{
  "schema": "pcg/module-workshop-web-verification/v1",
  "scope": "web_and_read_only_evidence_projection",
  "checks": {
    "sharedFoundationContract": true,
    "exactDesignVersionBinding": true,
    "directedRouteAndAbilitySameRoute": true,
    "andOrAbilities": true,
    "initialPermissionAbilityContext": true,
    "browserWidths": [
      320,
      390,
      1280
    ],
    "draftExportImport": true,
    "unsubmittedOpinionsNotPromoted": true,
    "existing225DesignsUnchanged": true,
    "existing82ApprovalsUnchanged": true,
