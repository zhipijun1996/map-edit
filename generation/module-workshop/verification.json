  "commands": [
    "npm run check",
    "python3 tools/browser_module_workshop.py",
    "python3 tools/build_editor_site.py --out /tmp/module-workshop-site-final --no-history",
    "WORKSHOP_BASE=http://127.0.0.1:8890/generation/module-workshop/ python3 tools/browser_module_workshop.py"
