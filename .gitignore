.DS_Store
node_modules/
test-results/
*.log
__pycache__/
.godot/
dist/

# Direct-contact experiments retain full raw artifacts in versioned PCG archives.
/pcg/results/direct-*/

/pcg/results/open-valley-*/
/pcg/results/valley-complete-*/
/pcg/results/valley-formal-*/
/pcg/results/full-region-*/
/pcg/results/rock-content-*/
/pcg/results/ecosystem-*/
/generation/maps/ecosystem-v1/recoil-return/
/generation/maps/ecosystem-v1/reward-loop/
/generation/maps/ecosystem-v1/timed-return/

# New workshop batches are immutable; raw failures/snapshots live in archives.
/pcg/results/workshop-*/
# Junction probe originals and source snapshots are retained in content-workshop-junctions-v1.
/pcg/results/junction-*/
*.avi
/generation/workshop/gate-delayed-return-v2/

# Frozen woven-region raw cases/traces are preserved in its versioned archive.
pcg/results/woven*/
generation/maps/woven-region-v1/*/

/generation/maps/woven-region-calibration/

/generation/maps/woven-region-v1/*.mp4
# Immutable content experiments: raw originals are committed as verified archives.
/pcg/results/content-*/
/generation/maps/content-routes-v1/

# Raw batch30 runs are published in hash-verified pcg/archives shards.
/pcg/results/batch30-*/

# Prepared migrations are not a third authoritative module library.
/.cache/migration/
/pcg/results/foundation-migration-*/
/pcg/migration/foundation-v1/holdout-locks-v1.lock

# Native admission logs are required, hash-bound library evidence.
!/modules/**/*.log
!/modules-recycle/**/*.log

# Exact migration raw bytes retained in verified module-foundation-migration-v2.
/pcg/results/foundation-corner-*/
/pcg/results/foundation-robustness-*/

# Approved batch raw failures and exact snapshots are retained in its verified archive.
/pcg/results/approved-b001-*/

# First-40 exact-design raw evidence is retained in a versioned archive.
/pcg/results/approved-b040-*/

/pcg/results/approved-r024-*/

/pcg/results/approved-u157-*/
