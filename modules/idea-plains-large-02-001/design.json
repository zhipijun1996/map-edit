  "creativeInterpretation": {
    "解释": "同一岩岛的上下两条路线在空怪处会合。提前清怪改变路线机会，玩家看到箱子时就要决定要不要保留它。",
    "观察与决定": "上方短线需要空怪仍活着且在合适射击方向；下方长线要读横台/竖台及换乘齿轮。选快而难的命中续枪，还是清场后走长线。",
    "动作因果": "上岛诱开冲锋→掠到空怪右上→向左下命中、同枪反冲右上并回一枪→用保留枪次修正凹口。下线先追P再换Q，从同一怪的下扑恢复窗离台。",
    "能力与资源": "jump/shot_recoil；真实已提交空中命中仅补回一枪，不补满精力、不赠二跳。空怪3HP，可提前击杀；无自动重生。",
    "奖励": "右侧内凹局部岩壳中的宝箱，背面和顶面有实体与边界刺，洞口朝岛内；不能在模块外侧直接走到箱台。",
    "失败恢复": "失去空怪或漏枪时落低接岸，仍有P/Q长线取宝目标；所有低位重试和敌死取宝必须验证。",
    "回程": "从箱口下落到低岸，依次读Q/P回左侧L；不依赖空怪仍存活或同一发命中机会。",
    "廉价解": [
      "不命中也能一枪从岛顶直达宝箱",
      "安全清怪后下线同样短且无代价",
      "默认50px俯冲根本触不到Q离台点",
      "Q顶端自动送到箱口不用读怪和凹口",
      "漏枪落入无法恢复的区域",
      "绕宝库后壁或隔墙交互拿箱"
    ],
    "体验差异": "同一敌人是可消耗的路线机会；与LG01保留世界支撑不同，清怪本身会改变规划。两种自返回路线分别声明。",
    "Cell条件": [
      "原生diver/charger，原生线段P/Q、齿轮与边界刺",
      "怪物仅在home附近活动，不画成追遍全房",
      "需要绑定真实命中恢复机制及原资源上限，无新Cell必需"
    ]
  },
  "gaps": [
    "布局与P→Q动态会合、真实两条取宝路线均未实施。",
    "短线若不命中也同样便宜，应修几何/资源而不是声明必须射怪。",
    "敌死状态、身体凹口净空、回程、穿伤及操作容错UNKNOWN。"
  ],
