    {
      "id": "idea-96ba6bf1-9b60-470a-9128-54ae7ea44af3",
      "title": "错相升井：四台换乘，三道横锯",
      "sourceType": "human_idea",
      "verbatim": "两列两行平台，平台往上，整个模块瘦高。平台的速度相位不一定一样，空中增加3段横向移动齿轮，速度相位不一致，1个空中怪物。",
      "interpretation": {
        "observation": "同时读左右两列的高度/上行或回落方向、三道锯的扫掠方向，以及换乘旁的空怪状态。",
        "decision": "先追哪一台、何时离台；同列交接还是横移换列；齿轮逼近时跳开/反冲换落点，或跟随回落台暂退。",
        "causality": "载台真实承载和离台速度改变跳跃落点，三道独立周期的锯让同一跳点在不同时刻有不同风险。空中命中可返一发，射击本身同时改变横向/竖向运动。",
        "cells": [
          "已有实体往复载台×4",
          "已有正弦横移齿轮×3",
          "已有空中怪plains_diver×1",
          "底/顶可穿接岸",
          "可选顶箱"
        ],
        "abilities": [
          "jump",
          "shot_recoil"
        ],
        "resources": "不加二段跳/钩索；真实落台恢复基本动作，空中1发、命中返1发。敌可不打，能量与伤害沿用消费端原机制。",
        "terrain": "暂3×7，四个104×16实体台分两层两列；列间72px。低层轨512–784，高层128–448，不加中途固定踏板或安全旁路。",
        "reward": "抵达顶口接岸为主要收益，顶台右侧可选宝箱，从井内可见。",
        "recovery": "失误落回底台或低台；伤害不抹除，怪不自动复活，动态相位不为重试重置。能否带伤重试/撤退仍待验证。",
        "directions": "下口上进到顶口；回程从可穿顶台下穿后侧落、借回程台分段下降，实体移动台不能下穿。三个有向目标均UNKNOWN。",
        "cheapSolutions": [
          "站单台长时间不动",
          "只走一列的小跳链",
          "跳跃+反冲跨过换乘段",
          "贴侧边绕锯",
          "敌已死仍保有捷径",
          "受伤借位或邻模块入速"
        ],
        "difference": "与已有摆渡/齿轮相位挑战同族；这里强调两层独立承载和三层扫掠形成的换乘判断，不以物体数量新增家族。",
        "载台时序": [
          "L1上行约91px/s、单程3.0s，L2约114px/s、单程2.8s。",
          "R1约76px/s、单程3.6s，R2约80px/s、单程4.0s。",
          "四台有各自初相和端点短停；数值只是图稿初值，不是调参后已通过的结果。"
        ],
        "齿轮时序": [
          "G1周期2.8s、初相0.15；G2周期3.7s、初相0.85；G3周期4.6s、初相0.50。",
          "三个中心均在x64–320往返，半径24px；不是三道同步的墙。"
        ],
        "循环解释": "当前明确采用现有上下往复载台；图示时刻全在上行，随后也会回落。持续只向上循环是另一条缺规则的提案，不混同。"
      },
      "constraints": {
        "text": "下进上出"
      },
      "stage": "READY_FOR_IMPLEMENTATION",
      "humanApproval": "KEEP",
      "technicalStatus": "UNKNOWN",
      "productionApproval": false,
