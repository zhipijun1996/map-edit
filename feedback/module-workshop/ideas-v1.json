    {
      "id": "idea-orbit-choice-001",
      "sourceType": "ai_idea",
      "source": {
        "producer": "current_codex_session",
        "modelRevision": "UNKNOWN",
        "externalModelCalled": false,
        "inspiration": "用户提出过绕中心旋转的平台环岛结构；本次为图文流程示例。"
      },
      "verbatim": "环岛分流：从左岸追上绕空中中心点运行的载台，朝固定风铃开枪同时改变自身速度与载台启停。玩家根据运行相位，选择反冲离台到右岸，或继续向上到顶口可穿平台和宝箱。回程重新追台，不加一条独立安全通道。",
      "interpretation": {
        "observation": "观察载台相位、风铃位置和两个目的岸的高度。",
        "decision": "现在离岛去B，还是继续上行去C；开枪反冲也会启停载台。",
        "causality": "同一枪同时改变角色运动和载台运动状态，落脚点随之改变。",
        "cells": [
          "岩岸",
          "可穿平台",
          "风铃启停",
          "闭环环行承载台（支持待核）",
          "宝箱",
          "危险带"
        ],
        "abilities": [
          "jump",
          "shot_recoil"
        ],
        "resources": "现有真实精力/空中枪数；不赠送资源，最低需要量待解。",
        "terrain": "5×4矩形，三口分别位于左侧第3格、右侧第2格、顶边中格；中心留空，不建安全绕行层。",
        "reward": "宝箱位于C顶岸，环岛内可见，抵达后取。",
        "recovery": "A岸重试、底部受伤成本与复位尚需验证；不凭空加底台。",
        "directions": "三口六向都是待验目标，去程择岸与回程追台动作不同。",
        "cheapSolutions": [
          "直接跳过载台",
          "在岸上提前击铃得到静止捷径",
          "反冲越顶",
          "停台后单跳覆盖两岸"
        ],
        "difference": "空间上是同一动态环岛承载分叉选择；与既有A2仍可能同族，AI去重尚未完成。"
      },
      "stage": "READY_FOR_IMPLEMENTATION",
      "design": {
